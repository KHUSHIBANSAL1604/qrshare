# ---------------------------------------------------------------------------
# QRShare configuration.  Copy to `.env` and fill in real values.
# NEVER commit the real `.env` file.
#
# Generate the two secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"          -> SECRET_KEY
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"  -> MASTER_ENCRYPTION_KEY
# ---------------------------------------------------------------------------

# development | production | testing
FLASK_ENV=development

# Signs session cookies, CSRF tokens and download tickets.
SECRET_KEY=

# Base64 (urlsafe) encoded 32-byte key used to wrap each file's unique data key.
# Rotating or losing this key makes every stored file permanently unreadable.
MASTER_ENCRYPTION_KEY=

# --- Database -------------------------------------------------------------
# SQLite locally. In production use the managed Postgres connection string;
# a "postgres://" URL is normalised automatically.
DATABASE_URL=sqlite:///qrshare.db

# --- Storage --------------------------------------------------------------
# "local" writes to STORAGE_PATH; "s3" uses any S3-compatible object store.
# Container filesystems are wiped on redeploy, so hosted deployments need s3.
STORAGE_BACKEND=local

# Directory holding encrypted blobs when STORAGE_BACKEND=local.
# MUST be outside app/static.
STORAGE_PATH=./storage

# --- Object storage (only when STORAGE_BACKEND=s3) -------------------------
# Cloudflare R2 example:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# AWS S3 example:
#   S3_ENDPOINT_URL=            (leave blank)
#   S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=blobs

# --- Uploads --------------------------------------------------------------
MAX_FILE_SIZE_MB=100
# Comma separated. Empty = allow everything except BLOCKED_EXTENSIONS.
ALLOWED_EXTENSIONS=
BLOCKED_EXTENSIONS=exe,com,scr,bat,cmd,msi,cpl,jar,vbs,vbe,js,jse,ws,wsf,wsh,ps1,psm1,hta,lnk,scf,reg,dll,sys,pif,gadget,apk,app

# --- Share lifetime -------------------------------------------------------
DEFAULT_EXPIRY_MINUTES=60
MAX_EXPIRY_MINUTES=1440
# How long a consumed/expired share's row is kept before cleanup removes it.
CLEANUP_GRACE_MINUTES=10
# Background cleanup sweep interval (0 disables the in-process scheduler).
CLEANUP_INTERVAL_SECONDS=300

# --- Rate limits (Flask-Limiter syntax) -----------------------------------
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_UPLOAD=10 per hour;3 per minute
RATE_LIMIT_DOWNLOAD=60 per hour
RATE_LIMIT_PASSWORD=10 per hour;5 per minute
RATE_LIMIT_STATUS=120 per hour
# e.g. redis://localhost:6379 in production; memory:// is per-process only.
RATE_LIMIT_STORAGE_URI=memory://

# --- Public URL -----------------------------------------------------------
# Base URL embedded in the QR code. Leave blank to derive from the request.
# Set this (with https://) when running behind a reverse proxy.
PUBLIC_BASE_URL=

# --- HTTPS ----------------------------------------------------------------
# Only enable when TLS is genuinely terminated in front of the app.
ENABLE_HSTS=false
SESSION_COOKIE_SECURE=false

# --- Reverse proxy ---------------------------------------------------------
# Set to true when running behind a proxy that terminates TLS (Render, nginx).
# Without it the app sees http:// and the proxy's IP, which would put the
# wrong scheme in QR codes and merge every visitor into one rate-limit bucket.
TRUST_PROXY=false
