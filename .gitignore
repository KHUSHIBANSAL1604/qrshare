# Secrets — never commit
.env
.deploy.env
*.key

# Encrypted blobs and database.
# Leading slash anchors these to the repo root: without it, "storage/" also
# matches app/services/storage/, silently excluding the storage backend
# package from the repository.
/storage/
/instance/
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
