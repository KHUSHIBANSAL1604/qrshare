# ---------------------------------------------------------------------------
# Deployment credentials.
#
#   Copy this file to  .deploy.env  and fill in the values.
#   .deploy.env is gitignored and is never committed, printed or echoed back.
#
# Fill in whatever you have; I will tell you if something is missing.
# ---------------------------------------------------------------------------

# --- Cloudflare R2 (object storage for the encrypted files) ---------------
# Cloudflare dashboard -> R2 -> create a bucket, then "Manage R2 API Tokens"
# -> Create API token -> Object Read & Write.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Render (backend hosting) ---------------------------------------------
# dashboard.render.com -> account menu -> Account Settings -> API Keys
# -> Create API Key.
RENDER_API_KEY=

# --- Vercel (public front door) -------------------------------------------
# vercel.com -> account menu -> Settings -> Tokens -> Create Token (scope: full).
VERCEL_TOKEN=
