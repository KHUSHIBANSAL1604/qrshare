# ---------------------------------------------------------------------------
# Deployment credentials.
#
#   Copy this file to  .deploy.env  and fill in the values.
#   .deploy.env is gitignored and is never committed, printed or echoed back.
#
# Only two values are needed. Both services are free and neither asks for a
# card. Encrypted files are stored in Render's Postgres database, so there is
# no object-storage provider to sign up for.
# ---------------------------------------------------------------------------

# --- Render (hosts the application) ---------------------------------------
# dashboard.render.com -> account menu -> Account Settings -> API Keys
# -> Create API Key.
RENDER_API_KEY=

# --- Vercel (public front door) -------------------------------------------
# vercel.com -> account menu -> Settings -> Tokens -> Create Token.
VERCEL_TOKEN=
